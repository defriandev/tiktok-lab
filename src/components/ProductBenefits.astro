---
import { siteConfig } from '../config/active.config';

const { benefits } = siteConfig.digitalProduct;
---

<section class="space-y-5 border-t border-slate-200 pt-6" aria-labelledby="benefits-heading">
  <h2 id="benefits-heading" class="text-lg font-bold text-slate-900">
    {benefits.sectionTitle}
  </h2>

  <div class="space-y-3">
    {
      benefits.items.map((item) => (
        <div class="rounded-xl border border-slate-200 p-4 space-y-1">
          <h3 class="text-sm font-bold text-slate-900">{item.title}</h3>
          <p class="text-sm text-slate-700 leading-relaxed">{item.description}</p>
        </div>
      ))
    }
  </div>

  <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 space-y-2.5">
    <h3 class="text-sm font-bold text-slate-900">{benefits.whatsInsideTitle}</h3>
    <ul class="space-y-2">
      {
        benefits.whatsInside.map((line) => (
          <li class="flex items-start gap-2 text-sm text-slate-800">
            <span aria-hidden="true" class="font-bold text-slate-900">✓</span>
            <span>{line}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
