---
import { siteConfig } from '../config/site.config';

const { requireConsent, consentBanner } = siteConfig.tracking;
---

{
  requireConsent && (
    <aside
      id="consent-banner"
      class="fixed inset-x-4 bottom-4 z-50 mx-auto hidden max-w-md rounded-2xl border border-slate-300 bg-white p-4 shadow-lg"
      role="dialog"
      aria-live="polite"
      aria-label="Persetujuan privasi dan analitik"
    >
      <p class="text-xs text-slate-700 leading-relaxed">{consentBanner.message}</p>
      <div class="mt-3 flex items-center justify-end gap-2">
        <button
          id="consent-decline-btn"
          type="button"
          class="touch-target rounded-lg border border-slate-300 bg-white px-4 py-2 text-xs font-semibold text-slate-800 hover:bg-slate-50"
        >
          {consentBanner.declineLabel}
        </button>
        <button
          id="consent-accept-btn"
          type="button"
          class="touch-target rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800"
        >
          {consentBanner.acceptLabel}
        </button>
      </div>
    </aside>
  )
}

<script>
  import { getConsentStatus, setConsentStatus, trackEvent } from '../lib/tracking';

  const banner = document.getElementById('consent-banner');
  const acceptBtn = document.getElementById('consent-accept-btn');
  const declineBtn = document.getElementById('consent-decline-btn');

  if (banner && getConsentStatus() === 'unset') {
    banner.classList.remove('hidden');
  }

  acceptBtn?.addEventListener('click', () => {
    setConsentStatus('granted');
    banner?.classList.add('hidden');
    trackEvent('ViewContent', {
      content_name: document.title,
    });
  });

  declineBtn?.addEventListener('click', () => {
    setConsentStatus('denied');
    banner?.classList.add('hidden');
  });
</script>
