---
import { siteConfig } from '../config/active.config';

const { mediaKit } = siteConfig.linkInBio;
---

<section class="space-y-5 border-t border-slate-200 pt-6" aria-labelledby="mediakit-heading">
  <h2 id="mediakit-heading" class="text-lg font-bold text-slate-900">
    {mediaKit.sectionTitle}
  </h2>

  <!-- Key Creator Metrics -->
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
    {
      mediaKit.stats.map((stat) => (
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-3.5">
          <p class="text-xs font-medium text-slate-600">{stat.label}</p>
          <p class="mt-1 text-base font-bold text-slate-900">{stat.value}</p>
        </div>
      ))
    }
  </div>

  <!-- Audience Demographics -->
  <div class="space-y-2.5 rounded-xl border border-slate-200 p-4">
    <h3 class="text-sm font-bold text-slate-900">{mediaKit.demographicsTitle}</h3>
    <ul class="space-y-2">
      {
        mediaKit.demographics.map((item) => (
          <li class="flex items-center justify-between text-sm">
            <span class="text-slate-700">{item.label}</span>
            <span class="font-semibold text-slate-900">{item.percentage}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Rate Card -->
  <div class="space-y-3">
    <h3 class="text-sm font-bold text-slate-900">{mediaKit.rateCardTitle}</h3>
    <div class="space-y-2.5">
      {
        mediaKit.rateCard.map((item) => (
          <div class="rounded-xl border border-slate-200 p-4 space-y-1">
            <div class="flex items-start justify-between gap-3">
              <p class="text-sm font-bold text-slate-900">{item.service}</p>
              <p class="shrink-0 text-sm font-bold text-slate-900">{item.price}</p>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">{item.deliverables}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
