---
import { siteConfig } from '../config/site.config';

const { inquiryForm } = siteConfig.linkInBio;
const { phoneNumber } = siteConfig.whatsapp;
---

<section class="space-y-4 border-t border-slate-200 pt-6" aria-labelledby="inquiry-heading">
  <div class="space-y-1">
    <h2 id="inquiry-heading" class="text-lg font-bold text-slate-900">
      {inquiryForm.sectionTitle}
    </h2>
    <p class="text-sm text-slate-600">{inquiryForm.description}</p>
  </div>

  <form
    id="brand-inquiry-form"
    class="space-y-3 rounded-xl border border-slate-200 bg-slate-50 p-4"
    data-channel={inquiryForm.deliveryChannel}
    data-phone={phoneNumber}
    data-email={inquiryForm.emailAddress}
    data-submit-label={inquiryForm.submitLabel}
  >
    <!-- Honeypot field for basic spam protection -->
    <div class="hidden" aria-hidden="true">
      <label for="inquiry-website">Situs Web</label>
      <input
        id="inquiry-website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="space-y-1">
      <label for="inquiry-name" class="block text-xs font-semibold text-slate-800">
        Nama PIC
      </label>
      <input
        id="inquiry-name"
        name="name"
        type="text"
        required
        placeholder="Contoh: Budi Santoso"
        class="min-h-[44px] w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-900 focus:outline-none"
      />
    </div>

    <div class="space-y-1">
      <label for="inquiry-brand" class="block text-xs font-semibold text-slate-800">
        Nama Brand / Agensi
      </label>
      <input
        id="inquiry-brand"
        name="brand"
        type="text"
        required
        placeholder="Contoh: Brand Skincare Indonesia"
        class="min-h-[44px] w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-900 focus:outline-none"
      />
    </div>

    <div class="space-y-1">
      <label for="inquiry-contact" class="block text-xs font-semibold text-slate-800">
        Nomor WhatsApp atau Email
      </label>
      <input
        id="inquiry-contact"
        name="contact"
        type="text"
        required
        placeholder="0812xxxx atau nama@brand.com"
        class="min-h-[44px] w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-900 focus:outline-none"
      />
    </div>

    <div class="space-y-1">
      <label for="inquiry-message" class="block text-xs font-semibold text-slate-800">
        Ringkasan Kampanye / Kebutuhan
      </label>
      <textarea
        id="inquiry-message"
        name="message"
        rows="3"
        required
        placeholder="Contoh: 1x video TikTok review produk, jadwal tayang bulan ini."
        class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-900 focus:outline-none"
      ></textarea>
    </div>

    <button
      type="submit"
      class="touch-target w-full rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
    >
      {inquiryForm.submitLabel}
    </button>

    <p id="inquiry-feedback" class="hidden text-xs font-medium text-emerald-700" role="status"></p>
  </form>
</section>

<script>
  import { trackEvent } from '../lib/tracking';
  import { buildWhatsAppUrl } from '../lib/whatsapp';

  const RATE_LIMIT_KEY = 'tiktok_lp_inquiry_last_submit';
  const COOLDOWN_MS = 30_000;

  const form = document.getElementById('brand-inquiry-form') as HTMLFormElement | null;
  const feedbackEl = document.getElementById('inquiry-feedback');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const formData = new FormData(form);
    const honeypot = String(formData.get('website') || '').trim();
    if (honeypot.length > 0) {
      return;
    }

    try {
      const lastSubmit = Number(window.sessionStorage.getItem(RATE_LIMIT_KEY) || 0);
      const remainingMs = COOLDOWN_MS - (Date.now() - lastSubmit);
      if (lastSubmit > 0 && remainingMs > 0) {
        if (feedbackEl) {
          feedbackEl.textContent = `Mohon tunggu ${Math.ceil(remainingMs / 1000)} detik sebelum mengirim ulang.`;
          feedbackEl.classList.remove('hidden');
        }
        return;
      }
    } catch {
      // Ignore storage errors in restricted browsers
    }

    const name = String(formData.get('name') || '').trim();
    const brand = String(formData.get('brand') || '').trim();
    const contact = String(formData.get('contact') || '').trim();
    const message = String(formData.get('message') || '').trim();

    if (!name || !brand || !contact || !message) {
      return;
    }

    const channel = form.dataset.channel || 'whatsapp';
    const phone = form.dataset.phone || '';
    const email = form.dataset.email || '';
    const submitLabel = form.dataset.submitLabel || 'Kirim Permintaan Kerja Sama';

    trackEvent('SubmitForm', {
      content_name: 'brand_inquiry',
      button_label: submitLabel,
    });

    const formattedText = [
      `Halo, saya ${name} dari ${brand}.`,
      `Kontak: ${contact}`,
      `Kebutuhan kerja sama: ${message}`,
    ].join('\n');

    const targetUrl =
      channel === 'email'
        ? `mailto:${encodeURIComponent(email)}?subject=${encodeURIComponent(`Permintaan Kerja Sama - ${brand}`)}&body=${encodeURIComponent(formattedText)}`
        : buildWhatsAppUrl({ phoneNumber: phone, message: formattedText, includeUtm: true });

    try {
      window.sessionStorage.setItem(RATE_LIMIT_KEY, String(Date.now()));
    } catch {
      // Ignore storage errors
    }

    if (feedbackEl) {
      feedbackEl.textContent = 'Data tercatat. Membuka aplikasi tujuan...';
      feedbackEl.classList.remove('hidden');
    }

    window.open(targetUrl, '_blank', 'noopener,noreferrer');
  });
</script>
