---
import { siteConfig } from '../config/active.config';

const { inquiryForm } = siteConfig.linkInBio;
const { phoneNumber } = siteConfig.whatsapp;
---

<section class="space-y-4 border-t border-slate-200 pt-6" aria-labelledby="inquiry-heading">
  <div class="space-y-1">
    <h2 id="inquiry-heading" class="text-lg font-bold text-slate-900">
      {inquiryForm.sectionTitle}
    </h2>
    <p class="text-sm text-slate-600">{inquiryForm.description}</p>
  </div>

  <form
    id="brand-inquiry-form"
    novalidate
    class="space-y-3 rounded-xl border border-slate-200 bg-slate-50 p-4"
    data-destination={inquiryForm.leadDestination}
    data-phone={phoneNumber}
    data-email={inquiryForm.emailAddress}
    data-endpoint={inquiryForm.leadEndpoint}
    data-submit-label={inquiryForm.submitLabel}
  >
    <!-- Honeypot field for basic spam protection -->
    <div class="hidden" aria-hidden="true">
      <label for="inquiry-website">Situs Web</label>
      <input
        id="inquiry-website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="space-y-1">
      <label for="inquiry-name" class="block text-xs font-semibold text-slate-800">
        Nama PIC
      </label>
      <input
        id="inquiry-name"
        name="name"
        type="text"
        required
        aria-describedby="inquiry-name-error"
        placeholder="Contoh: Budi Santoso"
        class="min-h-[44px] w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      />
      <p id="inquiry-name-error" class="hidden text-xs font-medium text-red-700" role="alert"></p>
    </div>

    <div class="space-y-1">
      <label for="inquiry-brand" class="block text-xs font-semibold text-slate-800">
        Nama Brand / Agensi
      </label>
      <input
        id="inquiry-brand"
        name="brand"
        type="text"
        required
        aria-describedby="inquiry-brand-error"
        placeholder="Contoh: Brand Skincare Indonesia"
        class="min-h-[44px] w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      />
      <p id="inquiry-brand-error" class="hidden text-xs font-medium text-red-700" role="alert"></p>
    </div>

    <div class="space-y-1">
      <label for="inquiry-contact" class="block text-xs font-semibold text-slate-800">
        Nomor WhatsApp (08.. / 62..) atau Email
      </label>
      <input
        id="inquiry-contact"
        name="contact"
        type="text"
        required
        aria-describedby="inquiry-contact-error"
        placeholder="0812xxxx atau nama@brand.com"
        class="min-h-[44px] w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      />
      <p id="inquiry-contact-error" class="hidden text-xs font-medium text-red-700" role="alert"></p>
    </div>

    <div class="space-y-1">
      <label for="inquiry-message" class="block text-xs font-semibold text-slate-800">
        Ringkasan Kampanye / Kebutuhan
      </label>
      <textarea
        id="inquiry-message"
        name="message"
        rows="3"
        required
        aria-describedby="inquiry-message-error"
        placeholder="Contoh: 1x video TikTok review produk, jadwal tayang bulan ini."
        class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      ></textarea>
      <p id="inquiry-message-error" class="hidden text-xs font-medium text-red-700" role="alert"></p>
    </div>

    <button
      id="inquiry-submit-btn"
      type="submit"
      class="touch-target w-full rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
    >
      {inquiryForm.submitLabel}
    </button>

    <p id="inquiry-feedback" class="hidden text-xs font-medium" role="status"></p>

    <a
      id="inquiry-fallback-wa"
      href="#"
      target="_blank"
      rel="noopener noreferrer"
      class="touch-target hidden w-full items-center justify-center rounded-xl border border-slate-900 bg-white px-4 py-2.5 text-xs font-bold text-slate-900 hover:bg-slate-100"
    >
      Buka WhatsApp Secara Manual
    </a>
  </form>
</section>

<script>
  import { trackEvent } from '../lib/tracking';
  import {
    buildWhatsAppUrl,
    getUtmParams,
    validateRequiredText,
    validateWhatsAppOrEmail,
  } from '../lib/whatsapp';

  const RATE_LIMIT_KEY = 'tiktok_lp_inquiry_last_submit';
  const COOLDOWN_MS = 30_000;

  const form = document.getElementById('brand-inquiry-form') as HTMLFormElement | null;
  const nameInput = document.getElementById('inquiry-name') as HTMLInputElement | null;
  const brandInput = document.getElementById('inquiry-brand') as HTMLInputElement | null;
  const contactInput = document.getElementById('inquiry-contact') as HTMLInputElement | null;
  const messageInput = document.getElementById('inquiry-message') as HTMLTextAreaElement | null;

  const nameErrorEl = document.getElementById('inquiry-name-error');
  const brandErrorEl = document.getElementById('inquiry-brand-error');
  const contactErrorEl = document.getElementById('inquiry-contact-error');
  const messageErrorEl = document.getElementById('inquiry-message-error');

  const submitBtn = document.getElementById('inquiry-submit-btn') as HTMLButtonElement | null;
  const feedbackEl = document.getElementById('inquiry-feedback');
  const fallbackWaLink = document.getElementById('inquiry-fallback-wa') as HTMLAnchorElement | null;

  let isSubmitting = false;

  function setFieldError(
    input: HTMLInputElement | HTMLTextAreaElement | null,
    errorEl: HTMLElement | null,
    message: string | null
  ): void {
    if (!input || !errorEl) return;
    if (message) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
      input.setAttribute('aria-invalid', 'true');
    } else {
      errorEl.textContent = '';
      errorEl.classList.add('hidden');
      input.removeAttribute('aria-invalid');
    }
  }

  function showFeedback(message: string, isError: boolean): void {
    if (!feedbackEl) return;
    feedbackEl.textContent = message;
    feedbackEl.classList.remove('hidden', 'text-emerald-700', 'text-red-700');
    feedbackEl.classList.add(isError ? 'text-red-700' : 'text-emerald-700');
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (isSubmitting) return;

    const formData = new FormData(form);
    const honeypot = String(formData.get('website') || '').trim();
    if (honeypot.length > 0) return;

    const name = String(formData.get('name') || '').trim();
    const brand = String(formData.get('brand') || '').trim();
    const contact = String(formData.get('contact') || '').trim();
    const message = String(formData.get('message') || '').trim();

    const nameErr = validateRequiredText(name, 'Nama PIC');
    const brandErr = validateRequiredText(brand, 'Nama brand / agensi');
    const contactCheck = validateWhatsAppOrEmail(contact);
    const messageErr = validateRequiredText(message, 'Ringkasan kampanye', 5);

    setFieldError(nameInput, nameErrorEl, nameErr);
    setFieldError(brandInput, brandErrorEl, brandErr);
    setFieldError(contactInput, contactErrorEl, contactCheck.valid ? null : contactCheck.error || null);
    setFieldError(messageInput, messageErrorEl, messageErr);

    if (nameErr || brandErr || !contactCheck.valid || messageErr) {
      return;
    }

    try {
      const lastSubmit = Number(window.sessionStorage.getItem(RATE_LIMIT_KEY) || 0);
      const remainingMs = COOLDOWN_MS - (Date.now() - lastSubmit);
      if (lastSubmit > 0 && remainingMs > 0) {
        showFeedback(
          `Mohon tunggu ${Math.ceil(remainingMs / 1000)} detik sebelum mengirim ulang.`,
          true
        );
        return;
      }
    } catch {
      // Ignore storage errors
    }

    const destination = form.dataset.destination || 'whatsapp';
    const phone = form.dataset.phone || '';
    const email = form.dataset.email || '';
    const endpoint = form.dataset.endpoint || '/api/lead';
    const submitLabel = form.dataset.submitLabel || 'Kirim Permintaan Kerja Sama';

    const formattedText = [
      `Halo, saya ${name} dari ${brand}.`,
      `Kontak: ${contact}`,
      `Kebutuhan kerja sama: ${message}`,
    ].join('\n');

    const waFallbackUrl = buildWhatsAppUrl({
      phoneNumber: phone,
      message: formattedText,
      includeUtm: true,
    });

    isSubmitting = true;
    fallbackWaLink?.classList.add('hidden');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Mengirim...';
    }

    let success = false;

    if (destination === 'webhook') {
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            source: 'brand_inquiry',
            name,
            brand,
            contact,
            message,
            utms: getUtmParams(),
          }),
        });
        if (!res.ok) {
          throw new Error('Webhook failed');
        }
        success = true;
        showFeedback('Permintaan kerja sama berhasil dikirim.', false);
      } catch {
        showFeedback(
          'Pengiriman otomatis gagal. Silakan lanjutkan melalui tombol WhatsApp di bawah.',
          true
        );
        if (fallbackWaLink) {
          fallbackWaLink.href = waFallbackUrl;
          fallbackWaLink.classList.remove('hidden');
          fallbackWaLink.classList.add('flex');
        }
      }
    } else {
      const targetUrl =
        destination === 'email'
          ? `mailto:${encodeURIComponent(email)}?subject=${encodeURIComponent(`Permintaan Kerja Sama - ${brand}`)}&body=${encodeURIComponent(formattedText)}`
          : waFallbackUrl;

      const opened = window.open(targetUrl, '_blank', 'noopener,noreferrer');
      if (opened) {
        success = true;
        showFeedback('Data terkirim! Silakan lanjutkan di aplikasi tujuan.', false);
      } else {
        showFeedback(
          'Browser memblokir pembukaan otomatis. Ketuk tombol di bawah untuk membuka WhatsApp.',
          true
        );
        if (fallbackWaLink) {
          fallbackWaLink.href = waFallbackUrl;
          fallbackWaLink.classList.remove('hidden');
          fallbackWaLink.classList.add('flex');
        }
      }
    }

    if (success) {
      try {
        window.sessionStorage.setItem(RATE_LIMIT_KEY, String(Date.now()));
      } catch {
        // Ignore storage errors
      }
      trackEvent('SubmitForm', {
        content_name: 'brand_inquiry',
        button_label: submitLabel,
      });
      form.reset();
    }

    isSubmitting = false;
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.textContent = submitLabel;
    }
  });

  fallbackWaLink?.addEventListener('click', () => {
    const submitLabel = form?.dataset.submitLabel || 'Kirim Permintaan Kerja Sama';
    trackEvent('SubmitForm', {
      content_name: 'brand_inquiry_fallback',
      button_label: submitLabel,
    });
  });
</script>
