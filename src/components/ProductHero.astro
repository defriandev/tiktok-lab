---
import { siteConfig } from '../config/active.config';

const { hero } = siteConfig.digitalProduct;
const { productName, promoPrice } = siteConfig.digitalProduct.offer;
---

<section class="space-y-4" aria-labelledby="hero-heading">
  <div class="space-y-2 text-center">
    {
      hero.badge && (
        <span class="inline-block rounded-full bg-slate-900 px-3 py-1 text-xs font-semibold text-white">
          {hero.badge}
        </span>
      )
    }
    <h1 id="hero-heading" class="text-2xl font-extrabold tracking-tight text-slate-900">
      {hero.headline}
    </h1>
    <p class="text-sm text-slate-700 leading-relaxed">
      {hero.subheadline}
    </p>
  </div>

  <!-- 9:16 Vertical Media Container -->
  <div class="mx-auto w-full max-w-[240px] overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 aspect-[9/16]">
    {
      hero.mediaType === 'video' ? (
        <video
          src={hero.mediaUrl}
          playsinline
          muted
          loop
          controls
          preload="metadata"
          aria-label={hero.mediaAlt}
          class="h-full w-full object-cover"
        />
      ) : (
        <img
          src={hero.mediaUrl}
          alt={hero.mediaAlt}
          width="240"
          height="426"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-full w-full object-cover"
        />
      )
    }
  </div>

  <!-- Above-the-fold Primary CTA -->
  <div class="space-y-1.5 text-center">
    <a
      href="#penawaran"
      data-track-product-cta
      data-cta-label={hero.ctaLabel}
      data-product-name={productName}
      class="touch-target flex w-full items-center justify-center rounded-xl bg-slate-900 px-5 py-3.5 text-sm font-bold text-white transition-colors hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
    >
      {hero.ctaLabel} — {promoPrice}
    </a>
  </div>
</section>

<script>
  import { trackEvent } from '../lib/tracking';

  document.querySelectorAll<HTMLElement>('[data-track-product-cta]').forEach((el) => {
    el.addEventListener('click', () => {
      trackEvent('ClickButton', {
        content_name: el.dataset.productName || 'digital_product',
        button_label: el.dataset.ctaLabel || 'CTA',
      });
    });
  });
</script>
