---
import { siteConfig } from '../config/active.config';

const { socialProof } = siteConfig.digitalProduct;
---

<section class="space-y-5 border-t border-slate-200 pt-6" aria-labelledby="proof-heading">
  <div class="rounded-xl bg-slate-900 px-4 py-3 text-center text-white">
    <p id="proof-heading" class="text-sm font-bold">
      {socialProof.soldCountText}
    </p>
  </div>

  <!-- Buyer Testimonials -->
  <div class="space-y-3">
    {
      socialProof.testimonials.map((item) => (
        <blockquote class="rounded-xl border border-slate-200 bg-slate-50 p-4 space-y-2">
          <p class="text-sm text-slate-800 leading-relaxed">"{item.quote}"</p>
          <footer class="text-xs font-semibold text-slate-600">
            {item.name} · <span class="font-normal">{item.role}</span>
          </footer>
        </blockquote>
      ))
    }
  </div>

  <!-- Proof Screenshots -->
  {
    socialProof.screenshots.length > 0 && (
      <div class="grid grid-cols-1 gap-3">
        {socialProof.screenshots.map((shot) => (
          <div class="aspect-[16/10] overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
            <img
              src={shot.imageUrl}
              alt={shot.alt}
              width="640"
              height="400"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </div>
        ))}
      </div>
    )
  }
</section>
