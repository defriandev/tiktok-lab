---
import { siteConfig } from '../config/active.config';

const { portfolio } = siteConfig.linkInBio;
---

<section class="space-y-4 border-t border-slate-200 pt-6" aria-labelledby="portfolio-heading">
  <h2 id="portfolio-heading" class="text-lg font-bold text-slate-900">
    {portfolio.sectionTitle}
  </h2>

  <div class="grid grid-cols-1 gap-4">
    {
      portfolio.items.map((item) => (
        <article class="overflow-hidden rounded-xl border border-slate-200 bg-white">
          <div class="aspect-video w-full bg-slate-100">
            <img
              src={item.imageUrl}
              alt={`${item.brandName} — ${item.campaignTitle}`}
              width="640"
              height="360"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="space-y-1 p-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
              {item.brandName}
            </p>
            <h3 class="text-sm font-bold text-slate-900">{item.campaignTitle}</h3>
            <p class="text-xs text-slate-700">{item.resultSummary}</p>
            {item.linkUrl && (
              <a
                href={item.linkUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="touch-target mt-2 inline-flex items-center text-xs font-semibold text-slate-900 underline underline-offset-4"
              >
                Lihat detail kampanye
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
