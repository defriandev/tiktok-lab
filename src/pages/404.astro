---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/active.config';

const { profile } = siteConfig.linkInBio;
---

<BaseLayout
  title={`Halaman Tidak Ditemukan | ${profile.name}`}
  description="Maaf, halaman yang Anda cari tidak tersedia."
  canonicalPath="/404"
>
  <section class="space-y-5 py-12 text-center">
    <p class="text-xs font-bold uppercase tracking-widest text-slate-500">404</p>
    <h1 class="text-2xl font-extrabold text-slate-900">Halaman Tidak Ditemukan</h1>
    <p class="text-sm text-slate-700 leading-relaxed">
      Maaf, tautan yang Anda buka mungkin sudah dipindahkan atau salah ketik. Silakan kembali ke halaman utama {profile.name}.
    </p>
    <div class="flex flex-col gap-3 pt-2">
      <a
        href="/"
        class="touch-target flex w-full items-center justify-center rounded-xl bg-slate-900 px-5 py-3 text-sm font-bold text-white hover:bg-slate-800"
      >
        Kembali ke Beranda
      </a>
      <div class="grid grid-cols-2 gap-3">
        <a
          href="/bio"
          class="touch-target flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-semibold text-slate-900 hover:bg-slate-50"
        >
          Link-in-Bio
        </a>
        <a
          href="/produk"
          class="touch-target flex items-center justify-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs font-semibold text-slate-900 hover:bg-slate-50"
        >
          Produk Digital
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
