---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkInBioProfile from '../components/LinkInBioProfile.astro';
import MediaKitSection from '../components/MediaKitSection.astro';
import PortfolioGallery from '../components/PortfolioGallery.astro';
import BrandInquiryForm from '../components/BrandInquiryForm.astro';
import { siteConfig } from '../config/active.config';

const { bio } = siteConfig.site.pages;
---

<BaseLayout
  title={bio.title}
  description={bio.description}
  ogImage={bio.ogImage}
  canonicalPath="/bio"
>
  <div class="space-y-8 pb-8">
    <LinkInBioProfile />
    <MediaKitSection />
    <PortfolioGallery />
    <BrandInquiryForm />
  </div>
</BaseLayout>
