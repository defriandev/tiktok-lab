---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductHero from '../components/ProductHero.astro';
import ProductSocialProof from '../components/ProductSocialProof.astro';
import ProductBenefits from '../components/ProductBenefits.astro';
import ProductOfferFaq from '../components/ProductOfferFaq.astro';
import LeadForm from '../components/LeadForm.astro';
import StickyMobileCta from '../components/StickyMobileCta.astro';
import { siteConfig } from '../config/active.config';

const { leadForm } = siteConfig.digitalProduct;
const { produk } = siteConfig.site.pages;
---

<BaseLayout
  title={produk.title}
  description={produk.description}
  ogImage={produk.ogImage}
  canonicalPath="/produk"
>
  <div class="space-y-8 pb-28">
    <ProductHero />
    <ProductSocialProof />
    <ProductBenefits />
    <ProductOfferFaq />
    {leadForm.enabled && <LeadForm />}
  </div>

  <StickyMobileCta />
</BaseLayout>
