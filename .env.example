# ==============================================================================
# ENVIRONMENT VARIABLES — SERVER-SIDE & BUILD
# Salin file ini menjadi .env untuk lokal, atau isi di Dashboard Vercel/Cloudflare.
# JANGAN PERNAH menaruh kunci rahasia (TOKEN / SERVER_KEY) di kode klien (src/).
# ==============================================================================

# [WAJIB untuk Tracking Server] ID TikTok Pixel dari TikTok Events Manager
TIKTOK_PIXEL_ID=TODO_TIKTOK_PIXEL_ID

# [WAJIB untuk Events API] Access Token TikTok Events API (hanya dibaca di /api/tiktok-events)
TIKTOK_ACCESS_TOKEN=TODO_TIKTOK_EVENTS_API_ACCESS_TOKEN

# [WAJIB untuk SEO & Sitemap] URL produksi HTTPS tanpa slash akhir (contoh: https://kreator.id)
SITE_URL=https://example.com

# [OPSIONAL — Uji Coba] Kode dari tab "Test Events" TikTok Events Manager.
# Biarkan kosong di produksi agar event tidak masuk ke kanal test.
TIKTOK_TEST_EVENT_CODE=

# [OPSIONAL — Analitik Pembanding] Measurement ID Google Analytics 4 (format: G-XXXXXXXXXX)
GA4_MEASUREMENT_ID=TODO_GA4_MEASUREMENT_ID

# [OPSIONAL — Hanya jika checkout.enabled = true & provider = 'midtrans']
MIDTRANS_SERVER_KEY=TODO_MIDTRANS_SERVER_KEY
MIDTRANS_IS_PRODUCTION=false

# [OPSIONAL — Hanya jika checkout.enabled = true & provider = 'xendit']
XENDIT_SECRET_KEY=TODO_XENDIT_SECRET_KEY
XENDIT_CALLBACK_TOKEN=TODO_XENDIT_CALLBACK_TOKEN

# [OPSIONAL — Hanya jika leadDestination = 'webhook'] URL webhook eksternal (mis. Google Apps Script)
LEAD_WEBHOOK_URL=TODO_LEAD_WEBHOOK_URL
